<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>My contacts</h1>
    <% for(const contact of contacts) { %>
        <li>
            <p><strong><%= contact.name %></strong></p>
            <p>Email: <%= contact.email %></p>
            <p>Phone: <%= contact.phone %></p>
        </li>
    <% } %>
</body>
</html>